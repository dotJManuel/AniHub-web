# Client IDs públicos (no son secretos). Registra una app en cada sitio con el
# Redirect URL  <origen>/callback  (p. ej. http://localhost:5173/callback).
VITE_ANILIST_CLIENT_ID=
VITE_MAL_CLIENT_ID=

# Secret de MAL. SIN prefijo VITE_: solo lo lee el servidor (api/mal/*), nunca el navegador.
MAL_CLIENT_SECRET=

# Opcional: proxy en otro origen. Vacío = mismo dominio (/api/mal/*).
VITE_PROXY_URL=
